{
  "name": "oauth-board",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"wrangler dev --ip 127.0.0.1 --port 3001\" \"vite --host localhost\"",
    "build": "panda codegen && tsc --noEmit && vite build",
    "start": "npm run build && wrangler dev --ip 127.0.0.1 --port 5173",
    "test": "tsx --test server/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "prepare": "panda codegen",
    "predev": "panda codegen"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "jose": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@pandacss/dev": "^1.12.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.0",
    "miniflare": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.0.0"
  }
}
