{
  "files": {
    "includes": [
      "src/**",
      "server/**",
      "schema/**",
      "*.json",
      "*.jsonc",
      "*.ts",
      "*.cjs",
      "index.html",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useSingleVarDeclarator": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
