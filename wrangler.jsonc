{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oauth-board",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "OIDC_ISSUER": "https://api.id.maximum.vc",
    "OIDC_AUTHORIZATION_URL": "https://api.id.maximum.vc/oauth/authorize",
    "OIDC_TOKEN_URL": "https://api.id.maximum.vc/oauth/access-token",
    "OIDC_JWKS_URL": "https://api.id.maximum.vc/oauth/jwks"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oauth-board",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
